# Workbench configuration. Copy to ~/.config/workbench/env (mode 600).
# The systemd units load that file. Never commit real values.

# Login password hash. Set it with: npm run set-password
WORKBENCH_PASSWORD_HASH=

# Listen address. Keep 127.0.0.1 and expose through `tailscale serve`.
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=4310

# Extra origins allowed to send mutations, comma separated. Same-host requests
# are always allowed; set this only if you reach the app under another name.
WORKBENCH_ALLOWED_ORIGINS=

# Secure cookies require HTTPS (tailscale serve provides it). Set false only
# for plain-HTTP local development.
WORKBENCH_SECURE_COOKIES=true
WORKBENCH_SESSION_TTL_DAYS=30

# State location (database, worktrees, run logs). Defaults to ~/.local/share/workbench.
# WORKBENCH_STATE_DIR=/home/ubuntu/.local/share/workbench
# WORKBENCH_BACKUP_DIR=/home/ubuntu/.local/share/workbench/backups

# SSH host alias your desktop editor uses for this machine; enables
# "Open in Cursor/VS Code" links.
WORKBENCH_SSH_HOST=

# Application port blocks reserved per workspace (keep below 32768, the start of
# Linux's ephemeral range). Previews listen at app port + WORKBENCH_PREVIEW_OFFSET.
WORKBENCH_PORT_RANGE=10000-19999
WORKBENCH_PORTS_PER_WORKSPACE=200

# Retention.
WORKBENCH_EVENT_RETENTION_DAYS=14
WORKBENCH_RUN_RETENTION_DAYS=30
WORKBENCH_RUN_OUTPUT_LIMIT_MB=50
WORKBENCH_RUNS_DISK_LIMIT_MB=5000

# Codex. The worker refuses an untested CLI version unless this is 1.
# WORKBENCH_CODEX_BIN=codex
# WORKBENCH_CODEX_ALLOW_UNTESTED=0

# Claude (deferred; see docs/decisions/0003-claude-agent-sdk.md).
# ANTHROPIC_API_KEY=

WORKBENCH_LOG_LEVEL=info
